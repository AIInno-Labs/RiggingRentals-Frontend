NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public site URL (used for logo in outbound emails)
# NEXT_PUBLIC_APP_URL=https://your-app.example.com

# Optional — real outbound email (quote / confirm+TnC / invoice)
# https://resend.com — without this key, app falls back to mailto
RESEND_API_KEY=
RESEND_FROM_EMAIL=Rigging Rentals <onboarding@resend.dev>

# Super Admin (/super-admin) backend — the Rigg Rental Spring Boot API.
# Organizations + Privileges are real; everything else (dashboard, parameters,
# notifications, profile/MFA) still falls back to mock data, since the backend
# has no equivalent yet — see src/features/super-admin/api/http/rigg-rental-api.ts.
RIGG_RENTAL_API_URL=http://localhost:8090/api/v1

# Same value as above, client-readable (NEXT_PUBLIC_) — used by
# src/features/super-admin/api/client/browser-api.ts so Organizations/
# Privileges list calls go directly from the browser to the backend
# (visible in DevTools' Network tab) instead of only server-side.
# The backend's CORS_ALLOWED_ORIGINS must include this app's own origin.
NEXT_PUBLIC_RIGG_RENTAL_API_URL=http://localhost:8090/api/v1

# RIGG_RENTAL_SUPERADMIN_EMAIL=superadmin@rigg-rental.local
# RIGG_RENTAL_SUPERADMIN_PASSWORD=superadmin123
