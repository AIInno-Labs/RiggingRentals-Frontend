NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public site URL (used for logo in outbound emails)
# NEXT_PUBLIC_APP_URL=https://your-app.example.com

# Optional — real outbound email (quote / confirm+TnC / invoice)
# https://resend.com — without this key, app falls back to mailto
RESEND_API_KEY=
RESEND_FROM_EMAIL=Rigging Rentals <onboarding@resend.dev>

# Super Admin (/super-admin) data source — see docs/super-admin-api-contract.md
# mock (default): in-memory sample data, resets on server restart
# http: the full contract above at SUPER_ADMIN_API_URL — no backend implements this yet
# rigg-rental: the real Rigg Rental backend (Organizations + Privileges only; everything
#              else still falls back to mock — see api/http/rigg-rental-api.ts)
SUPER_ADMIN_API_MODE=mock
# SUPER_ADMIN_API_URL=https://your-api.example.com/api

# Used only when SUPER_ADMIN_API_MODE=rigg-rental
# RIGG_RENTAL_API_URL=http://localhost:8090/api/v1
# RIGG_RENTAL_SUPERADMIN_EMAIL=superadmin@rigg-rental.local
# RIGG_RENTAL_SUPERADMIN_PASSWORD=superadmin123
